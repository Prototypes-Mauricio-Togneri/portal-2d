{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "noEmit": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@scripts/*": [
        "./scripts/*"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "src/game/rules/**/*.ts",
    "src/solver/**/*.ts",
    "src/game/chamber_data.ts",
    "src/game/direction.ts",
    "src/game/frame_input.ts",
    "src/game/game_event.ts",
    "src/game/game_key.ts",
    "src/game/replay_data.ts",
    "src/game/text_hash.ts",
    "src/chambers/*.json",
    "scripts/fixtures/*.json",
    "scripts/solver_fixtures/*.json"
  ]
}
