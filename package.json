{
  "name": "portal-2d",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint:fix && npm run build",
    "verify": "npm run lint && npm run build && npm run smoke:engine && npm run replay:check && npm run random:walk && npm run compare:engines && npm run chamber:check",
    "smoke:engine": "tsx --tsconfig tsconfig.scripts.json scripts/smoke_engine.ts",
    "replay:check": "tsx --tsconfig tsconfig.scripts.json scripts/check_replays.ts",
    "random:walk": "tsx --tsconfig tsconfig.scripts.json scripts/random_walk.ts",
    "compare:engines": "tsx --tsconfig tsconfig.scripts.json scripts/compare_engines.ts",
    "chamber:check": "tsx --tsconfig tsconfig.scripts.json scripts/check_chambers.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
